# Runtime connection used by the app (Prisma Client) for normal queries.
# In production against Supabase, this is the Transaction Pooler connection
# string (port 6543). Append ?pgbouncer=true so Prisma disables prepared
# statements, which PgBouncer's transaction mode doesn't support:
#   postgresql://user:password@host:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/moneyscouter"

# Direct (unpooled/session-mode) connection used only by the Prisma CLI for
# migrations (`prisma migrate deploy`/`dev`). In production against
# Supabase, use the Session Pooler connection string (port 5432 via the
# pooler host, IPv4-compatible) rather than the raw direct connection,
# since most serverless platforms (including Vercel) cannot reliably reach
# Supabase's direct connection over IPv6:
#   postgresql://user:password@host:5432/postgres
# Locally this can be the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/moneyscouter"

# Required for the real (Apify, zero-AI) pipeline — "Start zoekronde" /
# runScoutReal. Server-only: never exposed to the browser, never logged.
# Without it, real discovery/enrichment throws a clear error instead of
# silently doing nothing; the mock/demo pipeline ("Demo uitvoeren") does
# not need it. Get a token from https://console.apify.com/settings/integrations
APIFY_API_TOKEN="your-apify-api-token"
