// MoneyScouter — Prisma schema
// See docs/ARCHITECTURE.md section D for the design rationale.

generator client {
  provider      = "prisma-client-js"
  // Vercel's serverless runtime is Amazon Linux (OpenSSL 3.x). "native" alone
  // is normally sufficient since `prisma generate` runs at Vercel build
  // time in the same environment the function later runs in, but declaring
  // the target explicitly is the documented, zero-risk way to avoid "query
  // engine not found" errors if that assumption ever doesn't hold.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (e.g. Supabase Transaction Pooler / PgBouncer) for
  // normal query traffic from serverless functions.
  url       = env("DATABASE_URL")
  // Direct (unpooled, session-mode) connection used only by the Prisma CLI
  // for schema migrations — `prisma migrate deploy`/`dev` route through
  // this instead of `url` automatically. Transaction-mode pooling does not
  // reliably support the advisory locks and DDL that migrations need. The
  // generated Prisma Client itself never uses directUrl at runtime, only
  // `url` — but this env var must still be set wherever `prisma generate`
  // or `prisma migrate` run (i.e. the Vercel build step), see README.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductStatus {
  DISCOVERED
  FILTERED_OUT
  ENRICHED
  SHORTLISTED
  RESEARCHED
  REJECTED
  WATCHLISTED
  INTERESTING
  HIGH_POTENTIAL
}

enum ComplianceRisk {
  LOW
  MEDIUM
  HIGH
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  BUDGET_STOPPED
}

// LLM_MOCK: the V1 pipeline (mock discovery + mock LLM agents), kept for
// demo/dev use without spending anything real.
// APIFY_DETERMINISTIC: V1.1 — real Apify discovery/enrichment, zero LLM
// calls, rule-based Judge. See docs/ARCHITECTURE_V1_1.md.
enum RunMode {
  LLM_MOCK
  APIFY_DETERMINISTIC
}

enum ApifyRunStatus {
  READY
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  ABORTED
}

enum DecisionStage {
  FILTER
  ENRICHMENT
  SHORTLIST
  JUDGE
}

// Funnel / judge verdicts, shared across stages (a given stage only uses a
// subset — e.g. FILTER only ever produces PASS or REJECT).
enum Verdict {
  PASS
  REJECT
  WATCH
  INTERESTING
  HIGH_POTENTIAL
}

enum AgentType {
  MARKET
  COMPETITOR
  SUPPLIER
  MARGIN
  BRAND
  ANGLE
  RISK
  SKEPTIC
  JUDGE
  // Added for the Apify/deterministic pipeline (V1.1). SCOUT/DEDUP/FILTER
  // are batch-level "code agents" with no single product — tracked via
  // PipelineStageRun rather than AgentResult. TREND replaces MARKET in
  // that mode (measurable signals only, no LLM demand interpretation).
  SCOUT
  DEDUP
  FILTER
  TREND
}

enum ModelTier {
  CHEAP
  STANDARD
  STRONG
}

enum TaskType {
  CLASSIFICATION
  EXTRACTION
  SUMMARIZATION
  REASONING
  JUDGE
}

enum AgentResultStatus {
  COMPLETED
  FAILED
  SKIPPED
}

enum ValidationStatus {
  DRAFT
  READY_FOR_APPROVAL
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Core product graph
// ---------------------------------------------------------------------------

model Product {
  id              String         @id @default(cuid())
  title           String
  normalizedTitle String
  category        String
  description     String?
  imageUrl        String?
  status          ProductStatus  @default(DISCOVERED)
  complianceRisk  ComplianceRisk @default(LOW)

  // Denormalized "latest known" values for fast list/dashboard queries.
  // Always derivable from Score/Decision history — kept in sync by the
  // pipeline, never hand-edited.
  currentScore   Int?
  currentVerdict Verdict?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  // How many times this product has been re-discovered (NEW + every
  // SEEN_BEFORE/UPDATED dedup encounter). A real, measured "repeated
  // appearance frequency" signal for the Trend Agent — master spec V1.1
  // section 5/10 — never a guess.
  timesSeen   Int      @default(1)
  createdAt   DateTime @default(now())

  sources             ProductSource[]
  fingerprints        ProductFingerprint[]
  decisions           Decision[]
  agentResults        AgentResult[]
  scores              Score[]
  watchlistEntry      Watchlist?
  competitorSightings CompetitorSighting[]
  validationTests     ValidationTest[]
  aiCalls             AiCall[]

  @@index([status])
  @@index([category])
  @@index([normalizedTitle])
}

model Supplier {
  id         String   @id @default(cuid())
  name       String
  platform   String // "aliexpress" | "alibaba" | "cjdropshipping" | "other"
  externalId String?
  rating     Float?
  url        String?
  createdAt  DateTime @default(now())

  sources ProductSource[]

  @@unique([platform, externalId])
}

model ProductSource {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier @relation(fields: [supplierId], references: [id])
  supplierProductId String

  url             String?
  price           Decimal
  currency        String   @default("EUR")
  oldPrice        Decimal? // pre-discount list price, when the source reports one
  discountPercent Float?
  shippingCost    Decimal?
  shippingDays    Int?
  moq             Int?
  reviewCount     Int?
  orderCount      Int?
  rating          Float?
  weightGrams     Int?
  raw             Json? // full raw item as returned by the provider, for fields we don't have a dedicated column for

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  priceHistory PriceHistory[]

  @@unique([supplierId, supplierProductId])
  @@index([productId])
}

// Deduplication key -> product id. "Never pay twice": every discovered raw
// item is hashed and looked up here before any analysis happens.
model ProductFingerprint {
  id        String   @id @default(cuid())
  hash      String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  algorithm String   @default("v1")
  createdAt DateTime @default(now())

  @@index([productId])
}

model PriceHistory {
  id              String        @id @default(cuid())
  productSourceId String
  productSource   ProductSource @relation(fields: [productSourceId], references: [id], onDelete: Cascade)
  price           Decimal
  observedAt      DateTime      @default(now())

  @@index([productSourceId, observedAt])
}

// ---------------------------------------------------------------------------
// Pipeline execution
// ---------------------------------------------------------------------------

model ResearchRun {
  id         String    @id @default(cuid())
  status     RunStatus @default(PENDING)
  mode       RunMode   @default(LLM_MOCK)
  trigger    String    @default("manual") // "manual" | "scheduled"
  testMode   Boolean   @default(false)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  discoveredCount     Int @default(0)
  rejectedCount       Int @default(0)
  passedFilterCount   Int @default(0)
  enrichedCount       Int @default(0)
  shortlistedCount    Int @default(0)
  deepResearchedCount Int @default(0)
  highPotentialCount  Int @default(0)
  marketEnrichedCount Int @default(0)

  // AI (LLM_MOCK mode) budget — see docs/ARCHITECTURE.md section E.
  budgetEur    Decimal
  hardLimitEur Decimal
  spendEur     Decimal @default(0)

  // Apify (APIFY_DETERMINISTIC mode) budget — tracked separately from the
  // AI budget above, per the V1.1 spec's "separate from AI budget".
  apifyBudgetUsd    Decimal?
  apifyHardLimitUsd Decimal?
  apifySpendUsd     Decimal  @default(0)

  stopReason String?

  decisions      Decision[]
  agentResults   AgentResult[]
  scores         Score[]
  aiCalls        AiCall[]
  apifyCalls     ApifyCall[]
  searchRuns     SearchRun[]
  pipelineStages PipelineStageRun[]

  createdAt DateTime @default(now())

  @@index([status])
  @@index([startedAt])
  @@index([mode])
}

// Content-hash keyed cache so unchanged products are never re-billed by the
// same pipeline stage twice.
model ResearchCache {
  id        String    @id @default(cuid())
  cacheKey  String    @unique
  stage     String // "enrichment" | "deep_research"
  productId String
  output    Json
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([productId, stage])
}

model AgentResult {
  id              String            @id @default(cuid())
  researchRunId   String
  researchRun     ResearchRun       @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  agentType       AgentType
  status          AgentResultStatus @default(COMPLETED)
  summary         String
  findings        Json
  modelTier       ModelTier
  promptVersionId String?
  promptVersion   PromptVersion?    @relation(fields: [promptVersionId], references: [id])
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?

  @@unique([researchRunId, productId, agentType])
  @@index([productId])
}

model Score {
  id            String      @id @default(cuid())
  researchRunId String
  researchRun   ResearchRun @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Rubric, each /10 — see docs/ARCHITECTURE.md section on Judge scoring.
  demand                 Int
  trend                  Int
  margin                 Int
  competition            Int
  // Brandability/marketing angles only apply in LLM_MOCK mode (Brand/Angle
  // agents don't run in APIFY_DETERMINISTIC mode — no LLM to generate
  // positioning or ad copy). Null in deterministic-mode Score rows.
  brandability           Int?
  marketingAngles        Int?
  supplierQuality        Int
  shipping               Int
  operationalEase        Int
  risk                   Int
  // APIFY_DETERMINISTIC mode only: how much room between purchase cost and
  // observed real market price (from Google Shopping enrichment). Null in
  // LLM_MOCK mode, which has no real market price data to compare against.
  marketPriceOpportunity Int?

  moneyScore  Int // 0-100, weighted combination of the above
  verdict     Verdict
  why         String[]
  concerns    String[]
  nextStep    String?
  weightsUsed Json // the exact weights used, for auditability

  createdAt DateTime @default(now())

  @@unique([researchRunId, productId])
  @@index([productId])
}

// Funnel decisions + audit trail: every REJECT/PASS/WATCH/... a product
// receives at any stage, with enough references to reconstruct "why".
model Decision {
  id              String        @id @default(cuid())
  researchRunId   String?
  researchRun     ResearchRun?  @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  stage           DecisionStage
  verdict         Verdict
  reasons         String[]
  ruleSetVersion  String?
  agentType       AgentType?
  modelTier       ModelTier?
  promptVersionId String?
  costEur         Decimal?
  createdAt       DateTime      @default(now())

  @@index([productId])
  @@index([researchRunId])
}

// ---------------------------------------------------------------------------
// Cost control
// ---------------------------------------------------------------------------

model AiCall {
  id               String         @id @default(cuid())
  researchRunId    String?
  researchRun      ResearchRun?   @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?       @relation(fields: [productId], references: [id])
  agentType        AgentType?
  provider         String
  model            String
  tier             ModelTier
  taskType         TaskType
  inputTokens      Int
  outputTokens     Int
  estimatedCostEur Decimal
  promptVersionId  String?
  promptVersion    PromptVersion? @relation(fields: [promptVersionId], references: [id])
  createdAt        DateTime       @default(now())

  @@index([createdAt])
  @@index([researchRunId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Apify data layer (V1.1) — see docs/ARCHITECTURE_V1_1.md
// ---------------------------------------------------------------------------

// Configurable search-term system (master spec V1.1 section 4). Editable
// from Settings; a Scout run selects a configurable number of enabled
// keywords rather than searching one static term.
model SearchTopic {
  id        String   @id @default(cuid())
  name      String   @unique // "home", "kitchen", "travel", ...
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  keywords SearchKeyword[]
}

model SearchKeyword {
  id         String      @id @default(cuid())
  topicId    String
  topic      SearchTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  keyword    String
  enabled    Boolean     @default(true)
  timesUsed  Int         @default(0)
  lastUsedAt DateTime?
  createdAt  DateTime    @default(now())

  searchRuns SearchRun[]

  @@unique([topicId, keyword])
}

// Which keywords were actually searched in a given ResearchRun, and how
// many raw items each one returned — part of the audit trail alongside
// Decision.
model SearchRun {
  id            String        @id @default(cuid())
  researchRunId String
  researchRun   ResearchRun   @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  keywordId     String
  keyword       SearchKeyword @relation(fields: [keywordId], references: [id])
  itemsReturned Int           @default(0)
  createdAt     DateTime      @default(now())

  @@index([researchRunId])
}

// One row per Apify Actor run this app started — the Apify equivalent of
// AiCall, feeding the separate Apify Cost Controller (docs/ARCHITECTURE_V1_1.md
// section 13). estimatedCostUsd is a conservative pre-run cap-based
// estimate; actualCostUsd is filled in from the run object's
// `usageTotalUsd` once the run finishes, where Apify reports it.
model ApifyCall {
  id               String         @id @default(cuid())
  researchRunId    String?
  researchRun      ResearchRun?   @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  actorId          String
  // Adapter id that made this call, e.g. "aliexpress-tortuga",
  // "aliexpress-crawlerbros", "google-shopping-apify" — lets the same
  // actorId be attributed to a specific provider implementation.
  provider         String?
  purpose          String // "discovery" | "market_enrichment"
  // The search term(s) this call was for. A batched call (multiple keywords
  // in one Actor run) stores them comma-joined.
  keyword          String?
  // The maxItems cap we requested for this call, for reconciling against
  // itemCount and computing real cost-per-item after the fact.
  requestedLimit   Int?
  apifyRunId       String         @unique
  datasetId        String?
  status           ApifyRunStatus @default(READY)
  itemCount        Int            @default(0)
  estimatedCostUsd Decimal
  actualCostUsd    Decimal?
  // Wall-clock time this call took (start-run through dataset fetch),
  // measured by us — independent of whether Apify reports its own
  // startedAt/finishedAt on an aborted or timed-out run.
  durationMs       Int?
  errorMessage     String?
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?

  @@index([startedAt])
  @@index([researchRunId])
}

// Batch-level "code agent" execution tracking for the deterministic
// pipeline (Scout/Dedup/Filter/Supplier/Competitor/Margin/Trend/Risk/Judge)
// — these operate on a whole run, not one product, so they don't fit
// AgentResult's per-product shape. Powers the Agents page's real
// status/last-run/processed/rejected/duration/cost/errors view, per V1.1
// spec section 12: "Do NOT fake agent activity."
model PipelineStageRun {
  id             String            @id @default(cuid())
  researchRunId  String
  researchRun    ResearchRun       @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  stage          AgentType
  status         AgentResultStatus @default(COMPLETED)
  dataSource     String? // e.g. "apify:crawlerbros/aliexpress-scraper"
  itemsProcessed Int               @default(0)
  itemsRejected  Int               @default(0)
  costUsd        Decimal?
  errorMessage   String?
  startedAt      DateTime          @default(now())
  finishedAt     DateTime?

  @@unique([researchRunId, stage])
  @@index([researchRunId])
}

model PromptVersion {
  id        String    @id @default(cuid())
  agentType AgentType
  version   Int
  template  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  agentResults AgentResult[]
  aiCalls      AiCall[]

  @@unique([agentType, version])
}

// ---------------------------------------------------------------------------
// Watchlist / competitors / validation lab
// ---------------------------------------------------------------------------

model Watchlist {
  id          String    @id @default(cuid())
  productId   String    @unique
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  reason      String
  addedAt     DateTime  @default(now())
  lastAlertAt DateTime?
}

model Competitor {
  id        String   @id @default(cuid())
  name      String
  domain    String?
  createdAt DateTime @default(now())

  sightings CompetitorSighting[]

  @@unique([name, domain])
}

model CompetitorSighting {
  id              String     @id @default(cuid())
  competitorId    String
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  productId       String
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  researchRunId   String?
  price           Decimal?
  positioning     String?
  url             String?
  // How confident the (fuzzy) title match is that this sighting is really
  // the same product, 0-1. Never presented as certain — see
  // docs/ARCHITECTURE_V1_1.md section 8.
  matchConfidence Float?
  createdAt       DateTime   @default(now())

  @@index([productId])
}

// Placeholder for the future Validation Lab (section 17). No automation is
// wired up in V1 — this exists so the interface/shape is ready.
model ValidationTest {
  id                 String           @id @default(cuid())
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  status             ValidationStatus @default(DRAFT)
  brandName          String?
  positioning        String?
  usp                String?
  targetAudience     String?
  headline           String?
  description        String?
  faq                Json?
  price              Decimal?
  offer              String?
  bundles            Json?
  landingCopy        String?
  adConcepts         Json?
  imagePrompts       Json?
  suggestedBudgetEur Decimal?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}
